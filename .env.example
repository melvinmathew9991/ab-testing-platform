# Copy to .env and adjust. Nothing here is secret today; the file exists so
# that configuration has one documented home as the services are added.

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# text for a terminal, json for a log aggregator
LOG_FORMAT=text

# --- API service -----------------------------------------------------------
ENVIRONMENT=development
# Upload and analysis limits. Cloud Run rejects bodies above ~32 MiB, so the
# upload cap stays below that.
MAX_UPLOAD_MB=25
MAX_ROWS=1000000
MAX_METRICS=20
MAX_PERMUTATIONS=20000
MAX_BOOTSTRAP=20000
# Comma-separated allowed origins; set to the UI URL in production.
CORS_ORIGINS=*
# Where the bundled demo datasets live. Set in the container image.
# DEMO_DATA_DIR=/app/data/raw
